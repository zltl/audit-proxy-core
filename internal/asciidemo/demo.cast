[2m\u001b[32mｰ\u001b[0m\u001b[32mﾃ\u001b[0m  \u001b[2m\u001b[32mﾎ\u001b[0m   \u001b[92m\u001b[1mﾓ\u001b[0m  \u001b[32mﾅ\u001b[0m  \u001b[2m\u001b[32mｼ\u001b[0m   \u001b[92m\u001b[1mﾏ\u001b[0m  \u001b[32mﾃ\u001b[0m\u001b[92m\u001b[1mｻ\u001b[0m \u001b[2m\u001b[32mﾎ\u001b[0m\u001b[32mﾆ\u001b[0m  \u001b[2m\u001b[32mﾓ\u001b[0m   \u001b[92m\u001b[1m1\u001b[0m  \u001b[32m0\u001b[0m  \u001b[2m\u001b[32mﾏ\u001b[0m   \u001b[92m\u001b[1mｻ\u001b[0m  \u001b[32mﾆ\u001b[0m\u001b[92m\u001b[1mﾐ\u001b[0m \u001b[2m\u001b[32mﾓ\u001b[0m\u001b[32mﾊ\u001b[0m  \u001b[2m\u001b[32m1\u001b[0m   \u001b[92m\u001b[1mﾂ\u001b[0m  \u001b[32mﾜ\u001b[0m  \u001b[2m\u001b[32mｻ\u001b[0m\n \u001b[32mﾋ\u001b[0m  \u001b[2m\u001b[32mﾐ\u001b[0m  \u001b[2m\u001b[32mﾊ\u001b[0m   \u001b[32mｵ\u001b[0m  \u001b[2m\u001b[32mﾂ\u001b[0m\u001b[32mｳ\u001b[0m \u001b[2m\u001b[32mﾜ\u001b[0m\u001b[2m\u001b[32mｰ\u001b[0m  \u001b[2m\u001b[32mﾋ\u001b[0m   \u001b[32mｱ\u001b[0m  \u001b[2m\u001b[32mﾘ\u001b[0m  \u001b[2m\u001b[32mｵ\u001b[0m   \u001b[32mｳ\u001b[0m  \u001b[2m\u001b[32mｰ\u001b[0m\u001b[32mﾃ\u001b[0m \u001b[2m\u001b[32mﾋ\u001b[0m\u001b[2m\u001b[32mﾎ\u001b[0m  \u001b[2m\u001b[32mｱ\u001b[0m   \u001b[32mﾅ\u001b[0m  \u001b[2m\u001b[32mｼ\u001b[0m  \u001b[2m\u001b[32mｳ\u001b[0m   \u001b[32mﾃ\u001b[0m  \u001b[2m\u001b[32mﾎ\u001b[0m\u001b[32mﾆ\u001b[0m \u001b[2m\u001b[32mｱ\u001b[0m\u001b[2m\u001b[32mﾓ\u001b[0m  \u001b[2m\u001b[32mﾅ\u001b[0m   \u001b[32m0\u001b[0m  \u001b[2m\u001b[32mﾏ\u001b[0m  \u001b[2m\u001b[32mﾃ\u001b[0m\n \u001b[32mｻ\u001b[0m  \u001b[2m\u001b[32mﾆ\u001b[0m  \u001b[2m\u001b[32mﾓ\u001b[0m   \u001b[32m1\u001b[0m  \u001b[2m\u001b[32m0\u001b[0m\u001b[32mﾂ\u001b[0m \u001b[2m\u001b[32mﾏ\u001b[0m\u001b[2m\u001b[32mﾜ\u001b[0m  \u001b[2m\u001b[32mｻ\u001b[0m   \u001b[32mﾐ\u001b[0m  \u001b[2m\u001b[32mﾊ\u001b[0m  \u001b[2m\u001b[32m1\u001b[0m   \u001b[32mﾂ\u001b[0m  \u001b[2m\u001b[32mﾜ\u001b[0m\u001b[32mｰ\u001b[0m \u001b[2m\u001b[32mｻ\u001b[0m\u001b[2m\u001b[32mﾋ\u001b[0m  \u001b[2m\u001b[32mﾐ\u001b[0m   \u001b[32mﾘ\u001b[0m  \u001b[2m\u001b[32mｵ\u001b[0m  \u001b[2m\u001b[32mﾂ\u001b[0m   \u001b[32mｰ\u001b[0m  \u001b[2m\u001b[32mﾋ\u001b[0m\u001b[32mﾎ\u001b[0m \u001b[2m\u001b[32mﾐ\u001b[0m\u001b[2m\u001b[32mｱ\u001b[0m  \u001b[2m\u001b[32mﾘ\u001b[0m   \u001b[32mｼ\u001b[0m  \u001b[2m\u001b[32mｳ\u001b[0m  \u001b[2m\u001b[32mｰ\u001b[0m\n \u001b[32mﾃ\u001b[0m  \u001b[2m\u001b[32mﾎ\u001b[0m   \u001b[92m\u001b[1mﾓ\u001b[0m  \u001b[32mﾅ\u001b[0m\u001b[92m\u001b[1m1\u001b[0m \u001b[2m\u001b[32mｼ\u001b[0m\u001b[32m0\u001b[0m  \u001b[2m\u001b[32mﾏ\u001b[0m   \u001b[92m\u001b[1mｻ\u001b[0m  \u001b[32mﾆ\u001b[0m  \u001b[2m\u001b[32mﾓ\u001b[0m   \u001b[92m\u001b[1m1\u001b[0m  \u001b[32m0\u001b[0m\u001b[92m\u001b[1mﾂ\u001b[0m \u001b[2m\u001b[32mﾏ\u001b[0m\u001b[32mﾜ\u001b[0m  \u001b[2m\u001b[32mｻ\u001b[0m   \u001b[92m\u001b[1mﾐ\u001b[0m  \u001b[32mﾊ\u001b[0m  \u001b[2m\u001b[32m1\u001b[0m   \u001b[92m\u001b[1mﾂ\u001b[0m  \u001b[32mﾜ\u001b[0m\u001b[92m\u001b[1mｰ\u001b[0m \u001b[2m\u001b[32mｻ\u001b[0m\u001b[32mﾋ\u001b[0m  \u001b[2m\u001b[32mﾐ\u001b[0m   \u001b[92m\u001b[1mﾘ\u001b[0m  \u001b[32mｵ\u001b[0m  \u001b[2m\u001b[32mﾂ\u001b[0m   \n \u001b[2m\u001b[32mｰ\u001b[0m  \u001b[2m\u001b[32mﾋ\u001b[0m   \u001b[32mｱ\u001b[0m  \u001b[2m\u001b[32mﾘ\u001b[0m\u001b[32mﾅ\u001b[0m \u001b[2m\u001b[32mｵ\u001b[0m\u001b[2m\u001b[32mｼ\u001b[0m  \u001b[2m\u001b[32mｳ\u001b[0m   \u001b[32mﾃ\u001b[0m  \u001b[2m\u001b[32mﾎ\u001b[0m  \u001b[2m\u001b[32mｱ\u001b[0m   \u001b[32mﾅ\u001b[0m  \u001b[2m\u001b[32mｼ\u001b[0m\u001b[32m0\u001b[0m \u001b[2m\u001b[32mｳ\u001b[0m\u001b[2m\u001b[32mﾏ\u001b[0m  \u001b[2m\u001b[32mﾃ\u001b[0m   \u001b[32mﾆ\u001b[0m  \u001b[2m\u001b[32mﾓ\u001b[0m  \u001b[2m\u001b[32mﾅ\u001b[0m   \u001b[32m0\u001b[0m  \u001b[2m\u001b[32mﾏ\u001b[0m\u001b[32mﾜ\u001b[0m \u001b[2m\u001b[32mﾃ\u001b[0m\u001b[2m\u001b[32mｻ\u001b[0m  \u001b[2m\u001b[32mﾆ\u001b[0m   \u001b[32mﾊ\u001b[0m  \u001b[2m\u001b[32m1\u001b[0m  \u001b[2m\u001b[32m0\u001b[0m   \n \u001b[2m\u001b[32mﾜ\u001b[0m  \u001b[2m\u001b[32mｻ\u001b[0